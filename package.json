{
  "name": "archon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Constrained AI staff-engineer runtime embedded in a repository.",
  "bin": {
    "archon": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm": "wasm-pack build crates/archon-core --target nodejs --out-dir pkg",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "simple-git": "^3.36.0",
    "yaml": "^2.9.0"
  }
}
